/* =========================
   GLOBAL BACKGROUND
========================= */

QWidget {
    background-color: #1E2A4A;
    color: white;
    font-family: Segoe UI;
}


/* =========================
   TITLES / HEADERS
========================= */

QLabel {
    background-color: #1E2A4A;
    color: white;
    font-size: 16px;
    font-weight: bold;
}


/* =========================
   GROUP BOX (Card Information)
========================= */

QGroupBox {
    background-color: #3F5FA8;
    border-radius: 10px;

    border: 1px solid #1E2A4A;

    margin-top: 12px;
    padding-top: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px 0 6px;

    background-color: #1E2A4A;
    color: white;

    font-size: 16px;
    font-weight: bold;
}


/* =========================
   PANELS
========================= */

QFrame {
    background-color: #3F5FA8;
    border-radius: 10px;
}


/* =========================
   TEXT AREAS
========================= */

QTextEdit {
    background-color: #3F5FA8;
    color: white;
    border: none;
}

QPlainTextEdit {
    background-color: #3F5FA8;
    color: white;
    border: none;
}


/* =========================
   INPUT FIELDS
========================= */

QLineEdit {
    background-color: #3F5FA8;
    color: white;
    border-radius: 6px;
    padding: 6px;
    border: 1px solid #7093EF;
}

QLineEdit:focus {
    border: 1px solid #9FB8F5;
}


/* =========================
   BUTTONS
========================= */

QPushButton {
    background-color: white;
    color: #1E2A4A;
    border-radius: 8px;
    padding: 8px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #D6E1FF;
}


/* =========================
   PRIMARY BUTTON
========================= */

QPushButton#primaryBtn {
    background-color: white;
    color: #1E2A4A;
}

QPushButton#primaryBtn:hover {
    background-color: #D6E1FF;
}


/* =========================
   SPINBOX
========================= */

QSpinBox {
    background-color: #3F5FA8;
    color: white;
    border-radius: 6px;
    padding: 4px;
    border: 1px solid #7093EF;
}

QSpinBox::up-button,
QSpinBox::down-button {
    background-color: white;
}


/* =========================
   TABLE
========================= */

QTableWidget {
    background-color: #3F5FA8;
    border-radius: 10px;
    gridline-color: #1E2A4A;
    color: white;
}

QTableWidget::item {
    padding: 6px;
}

QTableWidget::item:selected {
    background-color: #7093EF;
}


/* =========================
   TABLE HEADER
========================= */

QHeaderView::section {
    background-color: #7093EF;
    color: white;
    padding: 6px;
    border: none;
}


/* =========================
   SCROLLBAR
========================= */

QScrollBar:vertical {
    background: #1E2A4A;
    width: 10px;
}

QScrollBar::handle:vertical {
    background: #7093EF;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #9FB8F5;
}

/* =========================
   REMOVE UNWANTED LINES
========================= */

QFrame {
    border: none;
}

QGroupBox {
    border: none;
}

QGroupBox::title {
    background-color: #1E2A4A;
}